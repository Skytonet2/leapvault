# ---------- Mantle Network ----------
NEXT_PUBLIC_MANTLE_RPC_URL=https://rpc.mantle.xyz
NEXT_PUBLIC_MANTLE_SEPOLIA_RPC_URL=https://rpc.sepolia.mantle.xyz
NEXT_PUBLIC_DEFAULT_NETWORK=mantle-sepolia
# REQUIRED. Powers Reown AppKit (the universal wallet modal).
# Without this, mobile wallets, WalletConnect QR pairing, and email/social fallback
# will all be disabled. Free signup at https://dashboard.reown.com (1 minute).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Database ----------
# Leave empty in development to surface "not configured" empty states
DATABASE_URL=

# ---------- Smart Contracts (Mantle) ----------
AGENT_REGISTRY_CONTRACT=
TASK_REGISTRY_CONTRACT=
REPUTATION_CONTRACT=

# ---------- AI Provider Strategy ----------
# Primary provider: nvidia | ollama | local-ollama | openai
AI_PROVIDER=nvidia
AI_FALLBACK_PROVIDER=ollama
AI_MODEL_PRIMARY=z-ai/glm-5.1
AI_MODEL_FAST=
AI_MODEL_LOCAL=

# OpenAI / OpenAI-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# NVIDIA Build / NIM (OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.1

# Ollama Cloud
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=glm-5.1:cloud

# Local Ollama
LOCAL_OLLAMA_BASE_URL=http://localhost:11434
LOCAL_OLLAMA_MODEL=

# ---------- AI Cost Control ----------
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=1200
AI_TEMPERATURE=0.2
AI_DAILY_USER_LIMIT=100
AI_ENABLE_CACHE=true

# ---------- Email Auth ----------
# If set, sign-in codes are sent via Resend (https://resend.com).
# If unset, the code is returned in the API response with `demoCode: "..."`
# so the UI can display it as a "Demo mode" banner.
RESEND_API_KEY=
RESEND_FROM=

# ---------- Notifications ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---------- Execution Layer ----------
# Active execution provider: realclaw | byreal | manual | none
EXECUTION_PROVIDER=manual
# approval_required | auto (auto NOT recommended; user approval is the safety rail)
EXECUTION_MODE=approval_required
# Dry-run blocks real provider calls. Leave on until you're ready for live execution.
EXECUTION_DRY_RUN=true
EXECUTION_TIMEOUT_MS=30000
EXECUTION_RETRY_LIMIT=1

# RealClaw — optional execution provider
REALCLAW_ENABLED=false
REALCLAW_BASE_URL=
REALCLAW_API_KEY=
REALCLAW_WEBHOOK_SECRET=
REALCLAW_TELEGRAM_BOT_USERNAME=
REALCLAW_SESSION_ID=

# Byreal Agent Skills — optional CLI execution adapter
# Install once with: npx skills add byreal-git/byreal-agent-skills
BYREAL_SKILLS_ENABLED=false
BYREAL_CLI_PATH=byreal
BYREAL_SKILLS_REPO=byreal-git/byreal-agent-skills
BYREAL_OUTPUT_MODE=json
